PORT=5000
# Connexion PostgreSQL (Prisma 7 + adaptateur pg).
# DATABASE_URL est utilisée par le runtime applicatif (src/db.js).
DATABASE_URL=
# PRISMA_DATABASE_URL est utilisée par la CLI Prisma (migrate, db:execute...).
# Sur Neon (pooler), ajouter l'option endpoint du pooler, URL-encodée :
# PRISMA_DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require&options=endpoint%3Dep-xxx-pooler
PRISMA_DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES=24h
# Token temporaire 2 étapes (2FA admin) — secret DIFFÉRENT de JWT_SECRET
TEMP_TOKEN_EXPIRES=15m
JWT_2FA_SECRET=
# SMTP pour l'envoi du code de vérification admin par email (voir services/mailer.js)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# URL du frontend utilisée dans les emails (liens d'activation)
FRONTEND_URL=http://localhost:5173
# Fenêtre d'activation (minutes) — 30 en phase de test, 1440 pour 24 h
ACTIVATION_EXPIRES_MINUTES=30
CRON_ENABLED=true
# Compte admin créé par `npm run seed:admin` (scripts/seedAdmin.js) — valeurs FICTIVES
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123!
ADMIN_FIRST_NAME=John
ADMIN_LAST_NAME=Doe
# Stripe (paiement) — clés TEST. Remplacez par vos vraies clés test.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...