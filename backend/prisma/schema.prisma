// BMW AutoSell — schéma Prisma (source de vérité, Neon)
// Les noms de champs = noms de colonnes (snake_case) pour préserver
// exactement les formes d'objets JSON exposées par l'API.
// CHECK constraints et index partiels (soft-delete) sont appliqués en SQL
// brut via prisma/migrations (appendix/constraints.sql).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model roles {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(50)

  users users[]
}

model users {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  first_name               String    @default("") @db.VarChar(100)
  last_name                String    @default("") @db.VarChar(100)
  email                    String    @unique @db.VarChar(255)
  password_hash            String
  role_id                  Int?
  two_factor_secret        String?
  is_two_factor_enabled    Boolean   @default(false)
  is_active                Boolean   @default(false)
  activation_token_hash    String?
  activation_expires_at    DateTime? @db.Timestamptz(6)
  created_at               DateTime  @default(now()) @db.Timestamptz(6)
  updated_at               DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at               DateTime? @db.Timestamptz(6)
  profile_photo_data       Bytes?
  profile_photo_mime_type  String?   @db.VarChar(50)
  is_super_admin           Boolean   @default(false)

  role              roles?               @relation(fields: [role_id], references: [id])
  carts             carts[]
  vehicles_created  vehicles[]           @relation("vehicles_created_by")
  known_devices     known_devices[]
  admin_email_otps  admin_email_otps[]
  orders            orders[]
  reviews           reviews[]
  favorites         favorites[]
  admin_permissions admin_permissions?
  configuration_requests configuration_requests[] @relation("configuration_request_owner")
  configuration_requests_handled configuration_requests[] @relation("configuration_request_handled_by")
  request_messages      request_messages[]
  saved_configurations saved_configurations[]
  offers                offers[]             @relation("offers_created_by")
  order_status_history  order_status_history[] @relation("order_status_history_changed_by")
}

model vehicles {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  model_name       String   @db.VarChar(100)
  base_price       Decimal? @db.Decimal(10, 2)
  category         String   @default("SUV") @db.VarChar(30)
  series           String   @default("X") @db.VarChar(10)
  variant_label    String   @default("Models") @db.VarChar(50)
  is_new           Boolean  @default(false)
  is_m_performance Boolean  @default(false)
  drivetrain       String   @default("petrol") @db.VarChar(20)
  image_data       Bytes?
  image_mime_type  String?  @db.VarChar(50)
  image_key        String?
  image_updated_at DateTime? @db.Timestamptz(6)
  specs            Json?
  model3d_exterior_filename String?
  model3d_interior_filename String?
  created_by       String?  @db.Uuid
  created_at       DateTime @default(now()) @db.Timestamp(6)
  updated_at       DateTime @default(now()) @db.Timestamptz(6)
  deleted_at       DateTime? @db.Timestamptz(6)

  creator             users?               @relation("vehicles_created_by", fields: [created_by], references: [id])
  carts               carts[]
  orders              orders[]
  reviews             reviews[]
  favorites           favorites[]
  vehicle_accessories vehicle_accessories[]
  configuration_requests configuration_requests[]
  saved_configurations saved_configurations[]
  offers              offers[]
}

model accessories {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String    @db.VarChar(150)
  description         String?
  price               Decimal   @db.Decimal(10, 2)
  image_data          Bytes?
  image_mime_type     String?   @db.VarChar(50)
  image_key           String?
  image_updated_at    DateTime? @db.Timestamptz(6)
  stock_quantity      Int       @default(0)
  badge               String?   @db.VarChar(50)
  requires_adjustment Boolean   @default(false)
  created_at          DateTime  @default(now()) @db.Timestamp(6)
  deleted_at          DateTime? @db.Timestamp(6)

  vehicle_accessories vehicle_accessories[]
}

// Liaison accessoire <-> véhicule : un accessoire n'est proposé que sur les
// véhicules explicitement associés ici. Table de jointure pure (pas d'id
// propre) ; la suppression d'un véhicule ou d'un accessoire retire la liaison.
model vehicle_accessories {
  vehicle_id   String   @db.Uuid
  accessory_id String   @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamp(6)

  vehicle   vehicles    @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)
  accessory accessories @relation(fields: [accessory_id], references: [id], onDelete: Cascade)

  @@id([vehicle_id, accessory_id])
  @@index([accessory_id])
}

model carts {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String    @db.Uuid
  configuration_data Json
  is_validated       Boolean   @default(false)
  last_reminder_sent DateTime? @db.Timestamptz(6)
  vehicle_id         String?   @db.Uuid
  updated_at         DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at         DateTime? @db.Timestamptz(6)

  user    users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  vehicle vehicles? @relation(fields: [vehicle_id], references: [id])
  orders  orders[]
}

model favorites {
  user_id    String @db.Uuid
  vehicle_id String @db.Uuid

  user    users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  vehicle vehicles @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)

  @@id([user_id, vehicle_id])
}

model known_devices {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String   @db.Uuid
  device_id     String
  device_label  String?
  last_ip       String?
  last_location String?
  first_seen_at DateTime @default(now()) @db.Timestamp(6)
  last_seen_at  DateTime @default(now()) @db.Timestamp(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, device_id])
}

model admin_email_otps {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  code_hash  String
  expires_at DateTime @db.Timestamp(6)
  created_at DateTime @default(now()) @db.Timestamp(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model orders {
  id                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                    String    @db.Uuid
  vehicle_id                 String    @db.Uuid
  cart_id                    String?   @db.Uuid
  amount                     Decimal   @db.Decimal(10, 2)
  currency                   String    @default("GBP") @db.VarChar(3)
  stripe_checkout_session_id String?
  stripe_payment_intent_id   String?
  status                     String    @default("pending") @db.VarChar(20)
  processing_status          String    @default("pending") @db.VarChar(20)
  refunded_at                DateTime? @db.Timestamp(6)
  stripe_refund_id           String?
  receipt_sent_at            DateTime? @db.Timestamp(6)
  offer_id                   String?   @db.Uuid
  price_breakdown            Json?
  handover_dealer_id         String?   @db.Uuid
  scheduled_handover_at      DateTime? @db.Timestamp(6)
  vin                        String?   @db.VarChar(17)
  created_at                 DateTime  @default(now()) @db.Timestamp(6)

  user           users                  @relation(fields: [user_id], references: [id])
  vehicle        vehicles               @relation(fields: [vehicle_id], references: [id])
  cart           carts?                 @relation(fields: [cart_id], references: [id])
  reviews        reviews[]
  offer          offers?                @relation("order_offer", fields: [offer_id], references: [id], onDelete: SetNull)
  dealer         dealers?               @relation(fields: [handover_dealer_id], references: [id], onDelete: SetNull)
  status_history order_status_history[]
}

model reviews {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  vehicle_id String    @db.Uuid
  order_id   String    @unique @db.Uuid
  rating     Int       @db.SmallInt
  comment    String?
  status     String    @default("pending") @db.VarChar(20)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  deleted_at DateTime? @db.Timestamp(6)

  user    users    @relation(fields: [user_id], references: [id])
  vehicle vehicles @relation(fields: [vehicle_id], references: [id])
  order   orders   @relation(fields: [order_id], references: [id])
}

model admin_notifications {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type       String    @db.VarChar(30)
  message    String
  related_id String?   @db.Uuid
  is_read    Boolean   @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(6)
}

model admin_permissions {
  user_id             String   @id @db.Uuid
  can_manage_vehicles Boolean  @default(true)
  can_manage_orders   Boolean  @default(true)
  can_process_refunds Boolean  @default(false)
  can_manage_reviews  Boolean  @default(true)
  can_view_reports    Boolean  @default(false)
  can_manage_clients  Boolean  @default(true)
  updated_at          DateTime @default(now()) @db.Timestamp(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model dealers {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(150)
  city      String   @db.VarChar(100)
  latitude  Decimal  @db.Decimal(9, 6)
  longitude Decimal  @db.Decimal(9, 6)

  configuration_requests configuration_requests[]
  orders                 orders[]
  }

// Demande de configuration « Save and Confirm ». Créée immédiatement par un
// utilisateur authentifié, puis complétée par la page « Update details » (PUT).
// Le statut n'est modifié que par un admin / le système, jamais par le client.
model configuration_requests {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String?   @db.Uuid
  vehicle_id          String    @db.Uuid
  configuration_data  Json?
  salutation          String?   @db.VarChar(10)
  first_name          String?   @db.VarChar(100)
  last_name           String?   @db.VarChar(100)
  contact_preference  String    @default("email") @db.VarChar(10)
  email               String    @db.VarChar(255)
  phone_country_code  String?   @db.VarChar(5)
  phone_number        String?   @db.VarChar(30)
  preferred_dealer_id String?   @db.Uuid
  marketing_channels  Json?
  status              String    @default("new") @db.VarChar(20)
  admin_notes         String?
  handled_by          String?   @db.Uuid
  details_confirmed_at DateTime? @db.Timestamp(6)
  created_at          DateTime  @default(now()) @db.Timestamp(6)
  updated_at          DateTime  @default(now()) @db.Timestamp(6)

  user     users?              @relation("configuration_request_owner", fields: [user_id], references: [id], onDelete: SetNull)
  vehicle  vehicles            @relation(fields: [vehicle_id], references: [id])
  dealer   dealers?            @relation(fields: [preferred_dealer_id], references: [id], onDelete: SetNull)
  handler  users?              @relation("configuration_request_handled_by", fields: [handled_by], references: [id], onDelete: SetNull)
  messages request_messages[]
  offers   offers[]

  @@index([status], map: "idx_requests_status")
  @@index([user_id], map: "idx_requests_user")
}

// Message email envoyé dans le cadre d'une demande de configuration.
// `sent_by` NULL = message automatique. delivery_status conserve la trace d'un
// échec d'envoi (l'admin doit pouvoir le constater sans que la ligne disparaisse).
model request_messages {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_id      String    @db.Uuid
  sent_by         String?   @db.Uuid
  subject         String
  body            String
  delivery_status String    @default("sent") @db.VarChar(10)
  created_at      DateTime? @default(now()) @db.Timestamp(6)

  request configuration_requests @relation(fields: [request_id], references: [id], onDelete: Cascade)
  sender  users?                 @relation(fields: [sent_by], references: [id], onDelete: SetNull)

  @@index([request_id], map: "idx_request_messages_request")
}

// Configuration sauvegardée par un utilisateur (« Save only »). Suppression
// douce via deleted_at ; purgée après 90 jours comme les autres données RGPD.
model saved_configurations {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String    @db.Uuid
  vehicle_id         String    @db.Uuid
  configuration_data Json
  created_at         DateTime  @default(now()) @db.Timestamp(6)
  deleted_at         DateTime? @db.Timestamp(6)

  user    users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  vehicle vehicles @relation(fields: [vehicle_id], references: [id])

  @@index([user_id], map: "idx_saved_configurations_user")
}

// Offre personnalisée émise par un admin sur une demande de configuration.
// `price_breakdown` fige le décompte (convention TVA incluse) ; `total_amount`
// en est le total. Au plus une offre 'active' par demande (index partiel).
model offers {
  id                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_id                 String    @db.Uuid
  vehicle_id                 String    @db.Uuid
  created_by                 String?   @db.Uuid
  status                     String    @default("active") @db.VarChar(20)
  currency                   String    @default("GBP") @db.VarChar(3)
  total_amount               Decimal   @db.Decimal(10, 2)
  price_breakdown            Json
  delivery_weeks_min         Int?
  delivery_weeks_max         Int?
  notes                      String?
  terms_version              String?   @db.VarChar(20)
  stripe_checkout_session_id String?
  paid_order_id              String?   @db.Uuid
  expires_at                 DateTime? @db.Timestamptz(6)
  accepted_at                DateTime? @db.Timestamptz(6)
  created_at                 DateTime  @default(now()) @db.Timestamp(6)
  updated_at                 DateTime  @default(now()) @db.Timestamptz(6)

  request    configuration_requests @relation(fields: [request_id], references: [id], onDelete: Cascade)
  vehicle    vehicles               @relation(fields: [vehicle_id], references: [id])
  creator    users?                 @relation("offers_created_by", fields: [created_by], references: [id], onDelete: SetNull)
  orders     orders[]               @relation("order_offer")

  @@index([request_id], map: "idx_offers_request")
  @@index([status], map: "idx_offers_status")
  @@index([vehicle_id])
}

model order_status_history {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id   String    @db.Uuid
  to_status  String    @db.VarChar(20)
  note       String?
  changed_by String?   @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamp(6)

  order   orders @relation(fields: [order_id], references: [id], onDelete: Cascade)
  changer users? @relation("order_status_history_changed_by", fields: [changed_by], references: [id], onDelete: SetNull)
}
