{
  "name": "bmwautosell-backend",
  "version": "1.0.0",
  "description": "Backend API pour BMW AutoSell",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "seed:roles": "node scripts/seedRoles.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "seed:vehicles": "node scripts/seedVehicles.js",
    "seed:accessories": "node scripts/seedAccessories.js",
    "seed:configurator-specs": "node scripts/seedConfiguratorSpecs.js",
    "db:seed": "npm run seed:roles && npm run seed:admin && npm run seed:vehicles && npm run seed:accessories && npm run seed:configurator-specs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "geoip-lite": "^2.0.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0",
    "stripe": "^22.6.2",
    "ua-parser-js": "^2.0.10"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^7.10.0"
  }
}
